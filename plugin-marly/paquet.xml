<paquet
	prefix="marly"
	categorie="outil"
	version="3.7.1"
	etat="test"
	compatibilite="[4.2.0;4.4.*]"
	schema="3.6.0">

	<nom>Réglages et réservations de Marly-Gomont</nom>
	<licence>GNU/GPL v3</licence>

	<necessite nom="SPIP" compatibilite="[4.2.0;4.4.*]" />

	<pipeline nom="header_prive" inclure="marly_pipelines.php" />
	<pipeline nom="declarer_tables_objets_sql" inclure="base/marly.php" />
	<pipeline nom="declarer_tables_interfaces"  inclure="base/marly.php" />

	<!--
		SPIP prefixe le nom de la tache avec celui du plugin : << lettres >>
		devient << marly_lettres >>, et il cherche alors genie_marly_lettres_dist
		dans genie/marly_lettres.php. Declarer << marly_lettres >> ici donnait
		marly_marly_lettres, introuvable.
	-->
	<genie nom="lettres" periode="60" />

	<menu
		nom="configurer_marly"
		titre="marly:titre_reglages"
		parent="menu_configuration" />

	<menu
		nom="reservations"
		titre="marly:titre_espace"
		parent="menu_edition" />





</paquet>
