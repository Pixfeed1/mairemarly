<paquet
	prefix="marly"
	categorie="outil"
	version="3.14.5"
	etat="test"
	compatibilite="[4.2.0;4.4.*]"
	schema="3.14.0">

	<!--
		schema = la version de la BASE, et c'est ELLE que SPIP compare a la meta
		marly_base_version pour decider de lancer marly_upgrade(). Pas << version >>.
		Tant que les deux sont egales, SPIP considere la base a jour et n'execute
		rien : les fichiers sont neufs, les tables restent vieilles, et aucun
		message ne le signale.

		Cette valeur doit toujours valoir la DERNIERE etape declaree dans
		marly_administrations.php. Le verificateur le controle.
	-->

	<nom>Réglages et réservations de Marly-Gomont</nom>
	<licence>GNU/GPL v3</licence>

	<necessite nom="SPIP" compatibilite="[4.2.0;4.4.*]" />

	<pipeline nom="declarer_tables_objets_sql" inclure="base/marly.php" />
	<pipeline nom="declarer_tables_interfaces"  inclure="base/marly.php" />

	<!--
		SPIP prefixe le nom de la tache avec celui du plugin : << lettres >>
		devient << marly_lettres >>, et il cherche alors genie_marly_lettres_dist
		dans genie/marly_lettres.php. Declarer << marly_lettres >> ici donnait
		marly_marly_lettres, introuvable.
	-->
	<genie nom="lettres" periode="60" />

	<menu
		nom="configurer_marly"
		titre="marly:titre_reglages"
		parent="menu_configuration"
		icone="images/marly-reglages.svg" />

	<menu
		nom="reservations"
		titre="marly:titre_espace"
		parent="menu_edition"
		icone="images/marly-reservations.svg" />

	<menu
		nom="raccourcis"
		titre="marly:titre_raccourcis"
		parent="menu_configuration"
		icone="images/marly-raccourcis.svg" />

	<menu
		nom="associations"
		titre="marly:titre_associations"
		parent="menu_edition"
		icone="images/marly-associations.svg" />

	<menu
		nom="elus"
		titre="marly:titre_elus"
		parent="menu_edition"
		icone="images/marly-elus.svg" />

	<menu
		nom="demarches"
		titre="marly:titre_demarches"
		parent="menu_edition"
		icone="images/marly-demarches.svg" />

	<!--
		La lettre d'information a sa propre entree. Elle etait rangee sous
		<< Reservations >> parce qu'elle est arrivee apres, et qu'un ecran de
		plus dans un espace existant coute moins qu'un espace de plus. Mais
		personne ne cherche une lettre d'information dans les reservations :
		l'endroit ou une chose est rangee est la premiere explication de ce
		qu'elle est.
	-->
	<menu
		nom="lettres"
		titre="marly:titre_lettre_info"
		parent="menu_edition"
		icone="images/marly-lettres.svg" />





</paquet>
