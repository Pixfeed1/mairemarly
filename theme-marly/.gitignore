# .gitignore du thème — ce dépôt ne versionne QUE le thème.
# ---------------------------------------------------------------------------
# Le cœur de SPIP n'a rien à faire ici : il s'installe et se met à jour tout
# seul. Versionner le cœur, c'est se condamner à des conflits à chaque montée
# de version. On ne suit que ce qu'on écrit : le dossier squelettes/.

# --- JAMAIS versionné : contient les identifiants de la base ---------------
config/connect.php
config/*connect*.php
config/chmod.php

# --- Généré par SPIP, jamais à la main -------------------------------------
tmp/
local/
IMG/
config/base/
plugins/auto/

# --- Environnement de développement ----------------------------------------
.env
docker/data/
*.sql
*.sql.gz

# --- Photographies fournies par la mairie -----------------------------------
# Elles appartiennent à la commune, pas au thème, et pèsent lourd. Elles
# vivent dans IMG/ via l'espace privé, comme tout contenu.
squelettes/img/photos/

# NOTE — les polices de squelettes/fonts/ SONT versionnées, volontairement.
# Elles sont sous licence libre (SIL OFL), pèsent 200 Ko à elles toutes, et
# aucun script ne les régénère : les ignorer rendait le dépôt inutilisable
# tel quel, un clone sur le serveur n'aurait eu aucune police.

# --- Système ----------------------------------------------------------------
.DS_Store
Thumbs.db
*.log
